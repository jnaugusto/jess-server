    color: #b0b8c8;
    font-style: italic;
    white-space: nowrap;
  }
  .m-job-company {
    font-size: 10.5px;
    color: #e8580a;
    font-weight: 600;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 5px;
