    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .s-contact li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 10.5px;
    color: #8a9ab2;
