    print-color-adjust: exact;
  }

  * {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  /* ──────────────────────────────────────────
     A4 wrapper — exactly one page
  ────────────────────────────────────────── */
  .cv {
    width: 210mm;
    height: 297mm;
    display: grid;
    grid-template-columns: 68mm 1fr;
    overflow: hidden;
    background: #ffffff;
    margin: 0 auto;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11.5px;
    line-height: 1.5;
