     SIDEBAR
  ══════════════════════════════════════════ */
  .sidebar {
    background: #12122a;
    color: #b8c4d4;
    padding: 36px 20px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: hidden;
  }

  /* Name + role */
  .s-name {
    font-size: 21px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.5px;
    line-height: 1.15;
    margin-bottom: 5px;
  }
  .s-role {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #e8580a;
    margin-bottom: 22px;
  }

  /* Section labels */
  .s-label {
    font-size: 8.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #e8580a;
