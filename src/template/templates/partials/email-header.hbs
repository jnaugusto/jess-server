<!-- HEADER -->
<div style="background:#0a0b0d;padding:26px 36px 20px;">
  <table cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="vertical-align:middle;padding-right:12px;">
        <div style="width:36px;height:36px;background:#d4ff4f;border-radius:7px;text-align:center;line-height:40px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle;margin-top:-2px;">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="#0a0b0d"/>
            <circle cx="12" cy="9" r="2.5" fill="#d4ff4f"/>
          </svg>
        </div>
      </td>
      <td style="vertical-align:middle;">
        <div style="color:#ffffff;font-size:17px;font-weight:700;letter-spacing:0.1em;font-family:Georgia,'Times New Roman',serif;">MERIDIAN</div>
        <div style="color:#5a5b60;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;font-family:monospace;margin-top:1px;">Fleet Tracking</div>
      </td>
    </tr>
  </table>
  <div style="border-top:1px solid rgba(255,255,255,0.08);margin-top:18px;"></div>
</div>

<!-- HERO -->
<div style="background:#0a0b0d;padding:4px 36px 32px;">
  <div style="display:inline-block;background:rgba(212,255,79,0.14);color:#d4ff4f;font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;padding:4px 10px;border-radius:4px;margin-bottom:14px;font-family:monospace;">{{heroBadge}}</div>
  <h1 style="color:#ffffff;font-size:26px;font-weight:400;line-height:1.3;margin:0 0 10px;font-family:Georgia,'Times New Roman',serif;">{{{heroTitle}}}</h1>
  <p style="color:#a8a9ad;font-size:13px;line-height:1.65;margin:0;">{{heroSubtext}}</p>
</div>
