<style>
  html, body {
    margin: 0;
    padding: 0;
    background: #d0d0d0;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  * {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  /* ── A4, exactly one page ── */
  .inv {
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    background: #ffffff;
    margin: 0 auto;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    color: #1a1a2e;
    display: flex;
    flex-direction: column;
  }

  /* ── Accent top bar ── */
  .inv-topbar {
    background: #12122a;
    padding: 0 48px;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    flex-shrink: 0;
  }
  .inv-brand {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.5px;
    padding: 22px 0;
  }
  .inv-brand em {
    color: #e8580a;
    font-style: normal;
  }
  .inv-title-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    padding: 16px 0;
    border-left: 1px solid rgba(255,255,255,0.08);
    padding-left: 32px;
  }
  .inv-title-word {
    font-size: 26px;
    font-weight: 800;
    color: #e8580a;
    letter-spacing: -0.5px;
    line-height: 1;
    margin-bottom: 3px;
  }
  .inv-title-num {
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 1px;
  }

  /* ── Body ── */
  .inv-body {
    flex: 1;
    padding: 28px 48px 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: hidden;
  }

  /* ── From / To ── */
  .inv-parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 20px;
  }
  .party-label {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #e8580a;
    margin-bottom: 6px;
  }
  .party-name {
    font-size: 13px;
    font-weight: 700;
    color: #12122a;
    margin-bottom: 3px;
  }
  .party-detail {
    font-size: 11.5px;
    color: #6a7a8e;
    line-height: 1.7;
  }

  /* ── Dates row ── */
  .inv-dates {
    display: flex;
    gap: 0;
    background: #fdf0ea;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  .date-cell {
    flex: 1;
    padding: 12px 20px;
    border-right: 1px solid rgba(232,88,10,0.12);
  }
  .date-cell:last-child { border-right: none; }
  .date-lbl {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #c45000;
    margin-bottom: 3px;
  }
  .date-val {
    font-size: 12px;
    font-weight: 600;
    color: #12122a;
  }

  /* ── Line items ── */
  .inv-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
    flex-shrink: 0;
  }
  .inv-table thead th {
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ffffff;
    background: #12122a;
    padding: 10px 14px;
    text-align: left;
  }
  .inv-table thead th:nth-child(2),
  .inv-table thead th:nth-child(3),
  .inv-table thead th:nth-child(4) {
    text-align: right;
  }
  .inv-table tbody tr {
    border-bottom: 1px solid #f2f2f6;
  }
  .inv-table tbody tr:nth-child(even) {
    background: #fafafa;
  }
  .inv-table tbody tr:last-child { border-bottom: none; }
  .inv-table tbody td {
    font-size: 11.5px;
    color: #3a4458;
    padding: 10px 14px;
    vertical-align: top;
  }
  .inv-table tbody td:nth-child(2),
  .inv-table tbody td:nth-child(3),
  .inv-table tbody td:nth-child(4) {
    text-align: right;
    white-space: nowrap;
    color: #1a1a2e;
    font-weight: 500;
  }
  .item-sub {
    font-size: 10.5px;
    color: #a0aab8;
    margin-top: 1px;
    font-weight: 400;
  }

  /* ── Bottom row: notes + totals ── */
  .inv-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  /* Totals */
  .inv-totals {
    width: 240px;
  }
  .total-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 12px;
    color: #6a7a8e;
    border-bottom: 1px solid #f2f2f6;
  }
  .total-row:last-child { border-bottom: none; }
  .total-row.grand {
    margin-top: 6px;
    background: #e8580a;
    border-radius: 6px;
    padding: 11px 14px;
    font-size: 13.5px;
    font-weight: 700;
    color: #ffffff;
    border-bottom: none;
  }
  .total-row span:last-child { font-weight: 600; color: #1a1a2e; }
  .total-row.grand span:last-child { color: #ffffff; }

  /* Notes */
  .inv-notes {
    font-size: 11px;
    color: #9aabb8;
    line-height: 1.75;
    padding-top: 4px;
  }
  .inv-notes-title {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #c0cad8;
    margin-bottom: 6px;
  }

  /* ── Footer strip ── */
  .inv-footer {
    background: #f7f5f2;
    border-top: 1px solid #ede8e2;
    padding: 10px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    color: #b0bac8;
    flex-shrink: 0;
    margin-top: auto;
  }
  .inv-footer strong { color: #e8580a; }
</style>

<div class="inv">

  <!-- Top bar -->
  <div class="inv-topbar">
    <div class="inv-brand">Jess<em>.</em>dev</div>
    <div class="inv-title-block">
      <div class="inv-title-word">Invoice</div>
      <div class="inv-title-num"># {{invoiceNumber}}</div>
    </div>
  </div>

  <!-- Body -->
  <div class="inv-body">

    <!-- From / To -->
    <div class="inv-parties">
      <div>
        <div class="party-label">From</div>
        <div class="party-name">Jess Noel Augusto</div>
        <div class="party-detail">
          Full Stack Developer<br>
          Sydney, NSW, Australia<br>
          jnaugusto@email.com
        </div>
      </div>
      <div>
        <div class="party-label">Bill To</div>
        <div class="party-name">Sample Client Pty Ltd</div>
        <div class="party-detail">{{address}}</div>
      </div>
    </div>

    <!-- Dates -->
    <div class="inv-dates">
      <div class="date-cell">
        <div class="date-lbl">Invoice Date</div>
        <div class="date-val">{{invoiceDate}}</div>
      </div>
      <div class="date-cell">
        <div class="date-lbl">Due Date</div>
        <div class="date-val">{{dueDate}}</div>
      </div>
      <div class="date-cell">
        <div class="date-lbl">Payment Terms</div>
        <div class="date-val">Net 30</div>
      </div>
      <div class="date-cell">
        <div class="date-lbl">Status</div>
        <div class="date-val" style="color:#e8580a;">Unpaid</div>
      </div>
    </div>

    <!-- Line items -->
    <table class="inv-table">
      <thead>
        <tr>
          <th>Description</th>
          <th>Qty</th>
          <th>Rate</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            API Development — NestJS Backend
            <div class="item-sub">REST API with auth, background queuing &amp; PDF generation</div>
          </td>
          <td>40 hrs</td>
          <td>$150.00</td>
          <td>$6,000.00</td>
        </tr>
        <tr>
          <td>
            Mobile App Development — React Native
            <div class="item-sub">Offline-first Expo app with GPS tracking &amp; PowerSync</div>
          </td>
          <td>32 hrs</td>
          <td>$150.00</td>
          <td>$4,800.00</td>
        </tr>
        <tr>
          <td>
            Database Design &amp; Optimisation
            <div class="item-sub">Schema design, indexing &amp; N+1 query elimination</div>
          </td>
          <td>8 hrs</td>
          <td>$150.00</td>
          <td>$1,200.00</td>
        </tr>
        <tr>
          <td>
            Technical Documentation
            <div class="item-sub">Swagger API docs, README &amp; deployment runbooks</div>
          </td>
          <td>4 hrs</td>
          <td>$100.00</td>
          <td>$400.00</td>
        </tr>
      </tbody>
    </table>

    <!-- Bottom: notes + totals -->
    <div class="inv-bottom">

      <div>
        <div class="inv-notes-title">Payment Details</div>
        <div class="inv-notes">
          BSB: 062-000 &nbsp;·&nbsp; Account: 1234 5678<br>
          Please include the invoice number as reference.<br>
          Accepted: Bank Transfer, PayPal, Credit Card
        </div>
      </div>

      <div class="inv-totals">
        <div class="total-row">
          <span>Subtotal</span>
          <span>$12,400.00</span>
        </div>
        <div class="total-row">
          <span>GST (10%)</span>
          <span>$1,240.00</span>
        </div>
        <div class="total-row" style="padding-top:8px;font-weight:600;color:#3a4458;font-size:12.5px;border-bottom:none;">
          <span>Total (AUD)</span>
          <span>$13,640.00</span>
        </div>
        <div class="total-row grand">
          <span>Amount Due</span>
          <span>$13,640.00 AUD</span>
        </div>
      </div>

    </div>

  </div>

  <!-- Footer strip -->
  <div class="inv-footer">
    <span>Thank you for your business! — <strong>Jess.dev</strong></span>
    <span>Generated {{invoiceDate}} &nbsp;·&nbsp; {{invoiceNumber}}</span>
  </div>

</div>
