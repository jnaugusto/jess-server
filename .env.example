PORT=3005
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://jnaugusto.com
SKIP_ENV_VALIDATION=false
REDIS_HOST=localhost
REDIS_PORT=6379
PLAYWRIGHT_POOL_SIZE=2
PLAYWRIGHT_MAX_PAGES=10
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/jess_db
POWERSYNC_URL=http://localhost:8080
POWERSYNC_JWT_PRIVATE_KEY=<base64-encoded-private-key>
BETTER_AUTH_SECRET=<your-secret>
BETTER_AUTH_URL=http://localhost:3005/api/auth
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Google Drive — OAuth2 (works with personal Google accounts)
# Get the refresh token once via https://developers.google.com/oauthplayground
# Scope needed: https://www.googleapis.com/auth/drive.file
GOOGLE_OAUTH_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<your-google-oauth-refresh-token>
GOOGLE_DRIVE_FOLDER_ID=<your-google-drive-folder-id>
